      "ColumnDescribe": {
        "description": "information on a single column containing the following information:\n    - name: name or label of the column. If the column refers to the index, name with set to \"_wdms_index_\"\n    - monotonicity: if set to `None`, the values are not monotonic. Set to `increasing` if monotonic increasing,\n                    to `decreasing if monotonic decreasing. By convention and backward compatibility, set to\n                    `increasing` in case of empty dataframe.\n    - hasDuplicate: flag if values are not unique.\n    - hasNan: flag if values contains at least one missing value.\n    - dataType: data type of the values as string, e.g. `int64`. Set to `None` if dataframe is empty\n    - startEnd: dataframe serialized as dict/json which contains only the associated column with only its first and\n                last rows with index preserved. Pandas dataframe can be directly constructed from this dict.\n                In some cases, it could contains a single row or be empty if original dataframe contains a single\n                row or is empty.",
        "properties": {
          "dataType": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "data type of the values, e.g. 'float64'",
            "title": "Datatype"
          },
          "hasDuplicate": {
            "default": false,
            "description": "boolean if the column contains any duplicated values",
            "title": "Hasduplicate",
            "type": "boolean"
          },
          "hasNan": {
            "default": false,
            "description": "boolean if there are any NaNs",
            "title": "Hasnan",
            "type": "boolean"
          },
          "monotonicity": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Monotonicity"
              },
              {
                "type": "null"
              }
            ],
            "description": "If not None, data are monotonic increasing or decreasing"
          },
          "name": {
            "description": "name of the column, if index them set to '_wdms_index_'",
            "title": "Name",
            "type": "string"
          },
          "startEnd": {
            "additionalProperties": true,
            "description": "Simplified dataframe contains only the first and last row, with the reference column if requested.See https://pandas.pydata.org/docs/reference/api/pandas.DataFrame.to_dict.html `split` orient.Dataframe can simply be constructed directly using dataframe constructor as it.",
            "title": "Startend",
            "type": "object"
          }
        },
        "required": [
          "name",
          "startEnd"
        ],
        "title": "ColumnDescribe",
        "type": "object"
      },
